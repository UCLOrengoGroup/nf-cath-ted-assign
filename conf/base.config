/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/cathtedassign Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Process-specific resources, ported from upstream (UCLOrengoGroup/domain-annotation-pipeline)
        conf/singularity.config. Memory steps up on each retry (attempt 1 / 2 / 3+).
        Retries still only happen for the exit codes in errorStrategy above (e.g. out of memory),
        and resourceLimits caps every request on smaller machines.
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    // ---------- Input preparation ----------
    withName: 'CREATEINPUTZIP|CHUNKBYZIP|CHUNKBYZIP_HEAVY' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: 'GETUNIPROT' {
        // UniProt API: limit parallel requests and retry on any failure (network errors)
        maxForks      = 2
        errorStrategy = 'retry'
        maxRetries    = 5
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    // ---------- TED segmentation ----------
    withName: 'TED_MERIZO|TED_UNIDOC|TED_CHAINSAW' {
        // Upstream: baseline of ~12 GB free memory, more for longer chains (cpus from upstream docker.config)
        cpus       = 2
        maxRetries = 3
        time       = 12.h
        memory     = {
            if (task.attempt == 1) {
                if (params.max_chain_residues <= 200) { return 15.GB }
                if (params.max_chain_residues <= 500) { return 24.GB }
                return 32.GB
            }
            return task.attempt == 2 ? 48.GB : 63.GB
        }
    }

    withName: 'TED_CONSENSUS' {
        maxRetries = 3
        time       = 3.h
        memory     = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
    }

    // ---------- Post-TED processing ----------
    withName: 'CHOPPDBZIP' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    // ---------- Structure analysis ----------
    withName: 'STRIDE' {
        maxRetries = 3
        time       = 12.h
        memory     = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
    }

    withName: 'MEASUREGLOBULARITY' {
        maxRetries = 3
        time       = 12.h
        memory     = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: 'DOMAINQUALITY' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 31.GB : task.attempt == 2 ? 45.GB : 63.GB }
    }

    withName: 'PLDDT' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    // ---------- Foldseek ----------
    withName: 'FOLDSEEK_CREATEDB' {
        cpus       = 1
        maxRetries = 3
        memory     = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 15.GB : 25.GB }
    }

    withName: 'FOLDSEEK_EASYSEARCH' {
        cpus       = 2 // upstream: keep cpus low to prevent foldseek failures
        maxRetries = 3
        memory     = { task.attempt == 1 ? 5.GB : task.attempt == 2 ? 15.GB : 31.GB }
    }

    withName: 'FOLDSEEK_PROCESSRESULTS' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
    }

    // ---------- Final assembly ----------
    withName: 'TRANSFORMCONSENSUS|COLLECTRESULTS' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 24.GB : task.attempt == 2 ? 32.GB : 48.GB }
    }

    withName: 'COLLECTRESULTSFINAL' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
    }

    withName: 'BENCHMARK' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }
}
