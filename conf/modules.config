/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CREATEINPUTZIP|CHUNKBYZIP|CHUNKBYZIP_HEAVY' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'RENUMBERPDB|FILTERPDB|GETUNIPROT' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
    }

    withName: 'RENUMBERPDB' {
        publishDir = [
            path: { "${params.outdir}/prepare_input/renumber" },
            mode: params.publish_dir_mode,
            pattern: '*.{resmaps.zip,renumber_errors.tsv}'
        ]
    }

    withName: 'FILTERPDB' {
        publishDir = [
            path: { "${params.outdir}/prepare_input/filter" },
            mode: params.publish_dir_mode,
            pattern: '*.filter_metadata.tsv'
        ]
    }

    withName: 'GETUNIPROT' {
        publishDir = [
            path: { "${params.outdir}/prepare_input/uniprot" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHOPPDBZIP' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            [
                path: { "${params.outdir}/errors" },
                mode: params.publish_dir_mode,
                pattern: '*_empty_file_error.tar.gz'
            ],
            [
                path: { "${params.outdir}/chopped_pdbs" },
                mode: params.publish_dir_mode,
                pattern: '*_chopped_pdbs.tar.gz',
            ]
        ]
    }

    withName: 'RESTOREPDBNUMBERING' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/chopped_pdbs_restored" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHUNKSMD5' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/md5" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STRIDE' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/structure_analysis/stride" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MEASUREGLOBULARITY' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/structure_analysis/globularity" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'DOMAINQUALITY' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/structure_analysis/domain_quality" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLDDT' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/structure_analysis/plddt" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'JOIN_PLDDT_MD5' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        ext.args2  = '\'BEGIN {OFS="\\t"} FNR==NR {md5[$1]=$3; next} {print $1, $2, md5[$1]}\''
        publishDir = [
            path: { "${params.outdir}/structure_analysis/plddt_with_md5" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TED_MERIZO' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/ted/merizo" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TED_CHAINSAW' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/ted/chainsaw" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TED_UNIDOC' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/ted/unidoc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TED_CONSENSUS' {
        ext.prefix = { "${meta.id}_${meta.chunk_id}" }
        publishDir = [
            path: { "${params.outdir}/ted/consensus" },
            mode: params.publish_dir_mode
        ]
    }

}
